# Copy to .env and fill in. Nothing here is needed for `demo` / `bench` with the heuristic decider.

# --- Ollama: FREE local decider (ollama.com). Run once: ollama pull qwen2.5:1.5b ----------
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# --- Ollaya: FREE local Jev-compatible decider (https://ollaya.dev, then `ollaya serve`) --
OLLAYA_URL=http://127.0.0.1:11435/v1/systemone
# laya:en is a small encoder that runs on CPU; winnow:e4b is stronger but wants a GPU
OLLAYA_MODEL=laya:en

# --- Jev (TypeSafe AI, paid — optional) — early access waitlist at typesafe.ai -------------------------
TYPESAFE_API_KEY=
# pin a version once you've tuned thresholds (aliases move on release day)
JEV_MODEL=jev-latest
# hard latency budget for a decision before falling back to the local heuristic
DECIDER_BUDGET_MS=350

# --- LLM: any OpenAI-compatible endpoint. Groq has a free tier + very fast first token --
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# check console.groq.com/docs/models for current model names
LLM_MODEL=llama-3.1-8b-instant

# --- Deepgram: streaming STT + Aura TTS with one key (free credits on signup) ----------
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
TTS_MODEL=aura-2-thalia-en

# --- PHI handling --------------------------------------------------------------------
# salt for pseudonymous patient ids in traces (set a random value; never commit it)
PHI_HASH_SALT=change-me
# optional: your test persona's name, so live traces redact it
PATIENT_NAME=
